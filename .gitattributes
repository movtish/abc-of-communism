* text=auto
*.py text eol=lf
*.md text eol=lf
*.tex text eol=lf
*.json text eol=lf
# Preserve spreadsheet bytes and source hashes across operating systems.
*.csv -text whitespace=cr-at-eol
*.pdf binary
*.png binary
*.jpg binary
*.xls binary
supplementary/**/raw_sources/** -text
validation/source_checks/** -text
supplementary/**/raw_sources/** -whitespace
validation/source_checks/** -whitespace
# Fixed-width generated reports contain intentional padding.
*.txt -whitespace
